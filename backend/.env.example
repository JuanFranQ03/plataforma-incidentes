# --- Entorno local (copie este archivo a .env; .env NUNCA se sube a Git) ---
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:clave@localhost:5432/incidentes_db"
# Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="1h"
# Solo necesario si el frontend se sirve desde OTRO origen (p. ej. Live Server o Vercel)
CORS_ORIGINS="http://localhost:3000"
# Intentos de login por IP cada 15 min
LOGIN_LIMIT=10
# Contraseñas del seed (obligatorias si NODE_ENV=production)
# SEED_ADMIN_PASSWORD=
# SEED_ANALISTA_PASSWORD=
# SEED_LECTOR_PASSWORD=
